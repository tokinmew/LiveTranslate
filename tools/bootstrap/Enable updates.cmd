@echo off
setlocal DisableDelayedExpansion
set "LT_ENABLE_UPDATES_DIR=%~dp0"
set "LT_ENABLE_UPDATES_TARGET=%~1"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -STA -Command "$ErrorActionPreference='Stop'; try { Add-Type -AssemblyName System.Windows.Forms; $from=$env:LT_ENABLE_UPDATES_DIR; $script=Join-Path $from 'enable_updates.py'; if (!(Test-Path -LiteralPath $script -PathType Leaf) -or !(Test-Path -LiteralPath (Join-Path $from 'latest.json') -PathType Leaf)) { throw 'Extract all the files from the updater ZIP into the same folder first.' }; $root=$env:LT_ENABLE_UPDATES_TARGET; if (!$root) { $hint=$null; $apps=@(Get-Process -Name LiveTranslate -ErrorAction SilentlyContinue | ForEach-Object { try { if ($_.Path) { [IO.Path]::GetDirectoryName($_.Path) } } catch {} } | Select-Object -Unique); if ($apps.Count -eq 1) { $hint=$apps[0] }; $picker=New-Object System.Windows.Forms.FolderBrowserDialog; $picker.Description='Select your existing LiveTranslate folder containing LiveTranslate.exe.'; $picker.ShowNewFolderButton=$false; if ($hint) { $picker.SelectedPath=$hint } else { $standard=Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'Programs/LiveTranslate/app'; if (Test-Path -LiteralPath (Join-Path $standard 'LiveTranslate.exe') -PathType Leaf) { $picker.SelectedPath=$standard } }; if ($picker.ShowDialog() -ne 'OK') { $picker.Dispose(); exit 2 }; $root=$picker.SelectedPath; $picker.Dispose() }; if (Test-Path -LiteralPath $root -PathType Leaf) { if ([IO.Path]::GetFileName($root) -ine 'LiveTranslate.exe') { throw 'Select the installed LiveTranslate folder.' }; $root=[IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($root)) }; if (!(Test-Path -LiteralPath (Join-Path $root 'LiveTranslate.exe') -PathType Leaf)) { foreach ($child in @('app','LiveTranslate')) { $candidate=Join-Path $root $child; if (Test-Path -LiteralPath (Join-Path $candidate 'LiveTranslate.exe') -PathType Leaf) { $root=$candidate; break } } }; $root=(Get-Item -LiteralPath $root).FullName; $exe=Join-Path $root 'LiveTranslate.exe'; $py=Join-Path $root 'runtime\python.exe'; foreach ($file in @('backend\worker.py','ui\Program.cs','LiveTranslate.exe')) { if (!(Test-Path -LiteralPath (Join-Path $root $file) -PathType Leaf)) { throw 'The selected folder is missing LiveTranslate app files. Select your extracted app folder.' } }; $info=[Diagnostics.FileVersionInfo]::GetVersionInfo($exe); if ($info.ProductName -ine 'Live Translate' -or $info.FileMajorPart -ne 0 -or $info.FileMinorPart -ne 6 -or $info.FilePrivatePart -ne 0 -or $info.FileBuildPart -lt 1 -or $info.FileBuildPart -gt __LIVETRANSLATE_MAX_PATCH__) { throw 'This installer supports LiveTranslate 0.6.1 through __LIVETRANSLATE_RELEASE_VERSION__.' }; if (!(Test-Path -LiteralPath $py -PathType Leaf)) { throw 'Open LiveTranslate from the Start menu to prepare it. For a legacy portable copy, open Start.cmd. Then close the app and retry.' }; $open=@(Get-Process -Name LiveTranslate -ErrorAction SilentlyContinue | Where-Object { try { $_.Path -ieq $exe } catch { $false } }); if ($open.Count) { [void][Windows.Forms.MessageBox]::Show('Close this LiveTranslate dashboard to finish the one-time installation, then select OK.','Enable LiveTranslate updates','OK','Information'); $open=@(Get-Process -Name LiveTranslate -ErrorAction SilentlyContinue | Where-Object { try { $_.Path -ieq $exe } catch { $false } }); if ($open.Count) { throw 'LiveTranslate is still open. Close the app and run this installer again.' } }; & $py -I -B -X utf8 $script $root; exit $LASTEXITCODE } catch { [Console]::Error.WriteLine($_.Exception.Message); exit 1 }"
set "RESULT=%errorlevel%"
if "%RESULT%"=="2" exit /b 2
if not "%RESULT%"=="0" pause
exit /b %RESULT%
